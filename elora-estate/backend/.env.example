# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/eloraestate

# ── Auth ──────────────────────────────────────────────────
# Generate strong random values for these, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP (client login) ───────────────────────────────────
# In development, OTP_DEV_BYPASS=true logs the OTP to the server console
# instead of sending a real SMS, so you can build/test without an SMS vendor.
OTP_DEV_BYPASS=true
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMS/OTP provider (choose one during technical implementation — e.g. MSG91,
# Twilio Verify, or a WhatsApp-based OTP). Leave blank until a vendor is chosen.
SMS_PROVIDER=
SMS_API_KEY=

# ── WhatsApp notifications (visit workflow) ─────────────
# Required for V1 per product spec. Leave blank in dev — the notification
# service falls back to logging + in-app notifications only when unset.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ── Visit rules ───────────────────────────────────────────
# How many hours before a visit a Client can still reschedule/cancel it
# themselves (spec left the exact cutoff as an open question — see the
# requirements report). After this window, only Broker/Admin can adjust it.
VISIT_CLIENT_ACTION_CUTOFF_HOURS=2

# ── First Admin bootstrap (see src/utils/seedAdmin.js) ──
SEED_ADMIN_NAME=Admin
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_PASSWORD=change_me_immediately
